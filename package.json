{
  "name": "inpageedit-plugin-quick-cat",
  "version": "1.0.0",
  "description": "Edit page categories: add, remove, rename, sort keys, default sort, autocomplete and drag-to-reorder.",
  "type": "module",
  "author": "Wecury",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "node --import tsx dev/parse.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "inpageedit",
    "ipe",
    "mediawiki",
    "plugin",
    "category"
  ],
  "$ipe": {
    "name": "Quick Cat",
    "description": "Edit page categories: add, remove, rename, sort keys, default sort, autocomplete and drag-to-reorder.",
    "categories": [
      "editor",
      "utility"
    ],
    "loader": {
      "kind": "module",
      "entry": "dist/index.mjs",
      "styles": [
        "dist/style.css"
      ],
      "main_export": "default"
    },
    "dev_loader": {
      "entry": "src/index.ts"
    }
  },
  "devDependencies": {
    "@inpageedit/core": "^0.18.0",
    "@types/node": "^26.1.2",
    "sass": "^1.102.0",
    "tsx": "^4.23.1",
    "types-mediawiki": "^2.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "jsx-dom": "^8.1.6"
  }
}
